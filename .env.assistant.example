# Documentation only. App scripts do NOT auto-load this file.
# Add these values to SERVER environment secrets; never prefix secrets with VITE_.
# Required existing database/session secrets are documented in README.md.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_ACTIONS_ENABLED=true
AI_ASSISTANT_PROVIDER=disabled
OPENAI_API_KEY=
# Required only after deliberate provider activation; no model is assumed/tested.
AI_ASSISTANT_MODEL=
AI_ASSISTANT_TIMEOUT_MS=12000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=600
# Only for the explicitly invoked synthetic provider smoke command; leave unset normally.
# AI_PROVIDER_SMOKE_ALLOW=1
