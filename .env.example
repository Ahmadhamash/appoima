# SERVER ONLY. Fill locally; this file is not loaded automatically.
# For an existing installation preserve the original DATABASE_URL and SESSION_SECRET.
DATABASE_URL=
SESSION_SECRET=
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CONCIERGE_ENABLED=true
# Leave both empty for manual setup + deterministic local text + explicit public URLs.
OPENAI_API_KEY=
JORMALL_OPENAI_API_KEY=
# Existing source defaults are preserved, not a promise of your account's model access.
CONCIERGE_LLM_MODEL=gpt-6-sol
CONCIERGE_REALTIME_MODEL=gpt-realtime-2.1
CONCIERGE_REALTIME_VOICE=marin
# Optional, not required for the core paths.
SONIOX_API_KEY=
# Set TEST_DATABASE_DISPOSABLE=1 ONLY for a dedicated synthetic-test database.
# Never expose server keys through VITE_* variables.
