# Add these to the EXISTING server environment / Replit Secrets. Do not overwrite your DB/session secrets.
# Never use VITE_ variables for API keys. This example is not automatically loaded.
CONCIERGE_ENABLED=true
OPENAI_API_KEY=
# Optional Arabic speech-recognition companion; responses and voice stay on OpenAI.
SONIOX_API_KEY=
CONCIERGE_LLM_MODEL=gpt-6-luna
CONCIERGE_REASONING_EFFORT=xhigh
CONCIERGE_REALTIME_MODEL=gpt-realtime-2.1
CONCIERGE_REALTIME_VOICE=marin
# Keep the original DATABASE_URL and SESSION_SECRET in your server environment.
# The old Phase-5 read-only assistant has its own AI_ASSISTANT_* flags; they are unchanged.
